# Matrix / homeserver account the jack answers calls on
MATRIX_HOMESERVER_URL=https://hs.example
MATRIX_VOICE_ACCOUNT=@agent:hs.example
MATRIX_VOICE_PASSWORD=change-me
MATRIX_VOICE_ACCESS_TOKEN=PasteTokenFromLogin
# The device_id the crypto/olm store is bound to — token and store MUST match
JACK_DEVICE_ID=JACK01

# Caller allowlist: comma-separated full user ids. DEFAULT-DENY: with this
# unset or empty the jack answers nobody — set it to exactly who may call.
# JACK_ALLOWED_USERS=@you:hs.example

# RTC: LiveKit + the MatrixRTC authorization service (lk-jwt) in front of it
LIVEKIT_URL=wss://hs.example/lk
LIVEKIT_JWT_SERVICE_URL=https://hs.example/livekit-jwt
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me

# E2EE: outbound audio is frame-encrypted (AES-GCM) and our per-call media key
# is olm-distributed to room members. Set 0 only to publish plaintext while
# debugging (receive-side decryption always stays on).
JACK_E2EE_OUTBOUND=1

# Brain: any OpenAI-compatible /v1/chat/completions endpoint (ollama, vLLM, ...)
JACK_ADAPTER=openai_compat
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# Examples: llama3.2, qwen2.5:3b, mistral — anything your endpoint serves
OPENAI_COMPAT_MODEL=llama3.2
OPENAI_COMPAT_API_KEY=no-key-required
# Reasoning models (Qwen etc. on vLLM): keep max_tokens >= 500 or content is null
OPENAI_COMPAT_MAX_TOKENS=500
# Persona prompt for the small brain (omit for the neutral default)
# OPENAI_COMPAT_SYSTEM=You are ...

# Route: hybrid = small brain chats, [TASK:]/imperative turns escalate to the
#        full agent via the bridge. bridge = EVERY turn goes to the bridge
#        (small brain becomes bridge-down fallback). No bridge = chat only.
JACK_ROUTE=hybrid  # or: bridge (every turn to the full agent via the bridge)
# LAN-side agent bridge (bridge/agent_bridge.py). Optional.
JACK_TASK_BRIDGE_URL=http://192.168.1.10:8620

# STT backend: faster (faster-whisper, recommended) | whisper_cpp (server URL)
JACK_STT_BACKEND=faster
# Endpointing: consecutive silent 0.5s batches before a phrase is considered done
JACK_ENDPOINT_SILENCE_BATCHES=2

# TTS: OpenAI-compatible /v1/audio/speech endpoint (Chatterbox works great)
JACK_TTS_URL=http://localhost:8003/v1/audio/speech
JACK_TTS_VOICE=default
